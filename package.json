{
  "name": "chat2archive",
  "version": "0.1.0",
  "description": "Convert AI conversations into a provider-neutral, Zenodo-ready research archive (AIR — AI Interaction Record).",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MartinuzziFrancesco/chat2archive.git"
  },
  "homepage": "https://martinuzzifrancesco.github.io/chat2archive/",
  "bugs": "https://github.com/MartinuzziFrancesco/chat2archive/issues",
  "bin": {
    "chat2archive": "dist/cli/index.js"
  },
  "exports": {
